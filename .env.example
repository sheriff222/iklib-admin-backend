# ── Database ──
# For Supabase, use the shared/session pooler URL on port 5432 for Prisma.
DATABASE_URL=

# ── Auth ──
JWT_SECRET=
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d
REFRESH_TOKEN_COOKIE_NAME=iklib_rt
# Comma-separated origins allowed to call this API (frontend origins).
# In development (NODE_ENV != production), all origins are allowed automatically.
# In production, only these origins are allowed.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-admin-domain.com

# ── Gemini (ported from sfm_client_backend) ──
GEMINI_API_KEY=
GEMINI_GENERATE_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
SEMANTIC_MIN_SCORE=0.6

# ── Object storage (R2 or S3 — same API) ──
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# ── Server ──
PORT=4001
STUDENT_API_ORIGIN=http://localhost:4000
ADMIN_FRONTEND_ORIGIN=http://localhost:3001

# ── Verification (WhatsApp deep-link, number provided later) ──
WHATSAPP_VERIFICATION_NUMBER=

# ── Supabase (project credentials; see .env) ──
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
